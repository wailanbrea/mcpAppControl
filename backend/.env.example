APP_NAME="MCP AppControl"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Zona horaria para los horarios de las rutinas (ej. America/Mexico_City, Europe/Madrid)
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mcp_appcontrol
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Servidor WebSocket TypeScript (mcp-server)
# URL a la que el backend envía comandos para los dispositivos
WS_DISPATCH_URL=http://127.0.0.1:6001/command/dispatch
# Token compartido entre backend y WS server (el mismo valor en ambos .env)
WS_AUTH_TOKEN=
