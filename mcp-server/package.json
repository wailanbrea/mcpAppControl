{
    "name": "mcp-appcontrol-server",
    "version": "1.0.0",
    "description": "MCP Server para App Control - Orquestador de dispositivos Android",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=bundle/appcontrol-mcp.cjs",
        "start": "node dist/index.js",
        "dev": "tsx src/index.ts",
        "start:ws": "node dist/websocket-server.js",
        "dev:ws": "tsx src/websocket-server.ts"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.0.0",
        "axios": "^1.6.0",
        "express": "^4.18.0",
        "ws": "^8.16.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.0",
        "@types/uuid": "^9.0.7",
        "@types/ws": "^8.5.10",
        "esbuild": "^0.28.1",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0"
    }
}
